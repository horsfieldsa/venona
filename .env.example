# Copy to .env. Never commit .env.
#
# NOTE: there is deliberately no API key here. Venona runs its model service on
# a subscription, and a key sitting in this file would silently move every call
# onto metered billing -- so the API REFUSES TO START with one set, rather than
# letting it be discovered on a bill a month later.
#
# To pay per token on purpose, connect the key under Model in Admin. That
# records the choice, so the refusal above can tell an accident from a
# decision.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=venona-local

VENONA_DATA_DIR=./data

# ── auth ─────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT: turn it off. Everything binds to localhost and there is
# nothing between you and the app, which is the arrangement every module
# docstring in this project assumes.
#
# The API logs a loud warning at startup when this is 0, because the same
# setting on a public host would leave ~30 write endpoints open -- six of which
# spend your Claude subscription and one of which wipes Neo4j.
VENONA_AUTH_ENABLED=0

# For DEPLOYMENT, leave the flag unset (it defaults to on) and set these.
# `docs/DEPLOYMENT.md` has the Google Cloud Console walkthrough.
#
#   uv run venona auth new-secret   -> VENONA_AUTH_SESSION_SECRET
#   uv run venona auth token        -> VENONA_AUTH_API_TOKEN
#
# The server refuses to start if any of these is missing or too weak, including
# an EMPTY allowlist -- a Google OAuth client authenticates any Google account,
# so an empty list would mean anyone with one is you.
#
# VENONA_PUBLIC_URL=https://venona.example.com
# VENONA_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# VENONA_GOOGLE_CLIENT_SECRET=
# VENONA_AUTH_ALLOWED_EMAILS=you@example.com
# VENONA_AUTH_SESSION_SECRET=
# VENONA_AUTH_API_TOKEN=
